POSTGRES_DB=equipamentos
POSTGRES_USER=equipamentos_app
POSTGRES_PASSWORD=troque_esta_senha_no_env_local
POSTGRES_PORT=5432

BACKEND_PORT=8080
FRONTEND_PORT=5173
# Configure como true no host HTTPS do backend de producao.
SESSION_COOKIE_SECURE=false

SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/equipamentos
SPRING_DATASOURCE_USERNAME=equipamentos_app
SPRING_DATASOURCE_PASSWORD=troque_esta_senha_no_env_local

# Em producao, use o JDBC Session pooler do Supabase com sslmode=require.
# Nunca coloque a senha real neste arquivo.

# URL do backend usada somente pelo servidor Next.js.
INTERNAL_API_BASE_URL=http://localhost:8080

# Usada somente pela skill local imagens-equipamentos.
# Crie a chave em https://pixabay.com/api/docs/ e mantenha o valor fora do Git.
PIXABAY_API_KEY=

# Somente para docker compose run --rm backend-provision.
PROVISION_USER_EMAIL=
PROVISION_USER_PASSWORD=
PROVISION_USER_FULL_NAME=
PROVISION_USER_ROLE=
